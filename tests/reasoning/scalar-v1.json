{
  "schema_version": 1,
  "scope": "Public synthetic arithmetic/v1 scalar examples. Excludes T3 boolean composition/conditional and T5 query semantics; not the frozen T0 corpus.",
  "cases": [
    {"id": "decimal-exactness", "request": {"nodes": {}, "declared": [], "expression": {"op": "add", "args": [{"num": "0.1"}, {"num": "0.2"}]}}, "expected": {"status": "ok", "value": {"type": "number", "numerator": "3", "denominator": "10"}, "steps": 3}},
    {"id": "division-nonzero", "request": {"nodes": {}, "declared": [], "expression": {"op": "div", "args": [{"num": "1"}, {"num": "3"}]}}, "expected": {"status": "ok", "value": {"type": "number", "numerator": "1", "denominator": "3"}}},
    {"id": "division-zero", "request": {"nodes": {}, "declared": [], "expression": {"op": "div", "args": [{"num": "1"}, {"num": "0"}]}}, "expected": {"status": "error", "value": null, "diagnostics": ["division_by_zero"]}},
    {"id": "null-is-value", "request": {"nodes": {}, "declared": [], "expression": {"null": true}}, "expected": {"status": "ok", "value": {"type": "null"}}},
    {"id": "missing-is-not-null", "request": {"nodes": {}, "declared": ["current"], "expression": {"ref": "current"}}, "expected": {"status": "unknown", "value": null, "diagnostics": ["missing_reference"], "potential_reads": ["current"], "executed_reads": ["current"]}},
    {"id": "quoted-id-is-text", "request": {"nodes": {}, "declared": [], "expression": {"text": "current"}}, "expected": {"status": "ok", "value": {"type": "text", "value": "current"}, "potential_reads": [], "executed_reads": []}},
    {"id": "no-boolean-number-coercion", "request": {"nodes": {}, "declared": [], "expression": {"op": "eq", "args": [{"num": "0"}, {"bool": false}]}}, "expected": {"status": "error", "value": null, "diagnostics": ["type_error"], "steps": 0}}
  ]
}
