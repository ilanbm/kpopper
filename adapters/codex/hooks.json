{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"../../scripts/session_open.sh\""
          },
          {
            "type": "command",
            "command": "\"../../scripts/ingestion_hook.sh\" codex start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"../../scripts/session_gate.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"../../scripts/ingestion_hook.sh\" codex wait",
            "async": true,
            "timeout": 130
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"../../scripts/ingestion_hook.sh\" codex wait",
            "async": true,
            "timeout": 130
          }
        ]
      }
    ]
  }
}
