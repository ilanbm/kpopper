{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/session_open.sh\" --host codex"
          },
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/ingestion_hook.sh\" codex start",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" \"watch_hook.py\" codex start",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" \"ground_hook.py\" codex start",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/ingestion_hook.sh\" codex wait",
            "async": true,
            "timeout": 130
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" \"followups_hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" \"watch_hook.py\" codex wait",
            "timeout": 130,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" \"ground_hook.py\" codex read",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/ingestion_hook.sh\" codex wait",
            "async": true,
            "timeout": 130
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" \"watch_hook.py\" codex wait",
            "timeout": 130,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" \"ground_hook.py\" codex prompt",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/session_gate.sh\" --host codex --context UserPromptSubmit"
          }
        ]
      }
    ]
  }
}
