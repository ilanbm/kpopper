{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/scripts/hook.py\" SessionStart"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/scripts/hook.py\" SessionEnd"
          }
        ]
      }
    ]
  }
}
