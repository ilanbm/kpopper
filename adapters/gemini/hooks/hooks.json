{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${extensionPath}/../../scripts/session_open.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${extensionPath}/scripts/checknote.sh"
          }
        ]
      }
    ]
  }
}
