{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "../../../scripts/session_open.sh",
        "timeout": 15
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "../../../scripts/session_gate.sh --context UserPromptSubmit",
        "timeout": 15
      }
    ]
  }
}
