{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assessment_profile": {
      "const": "ordinary-reader/v1"
    },
    "attention_policy": {
      "enum": [
        "focused-review/v1",
        "falsifiers-only/v1"
      ]
    },
    "record_revision": {
      "type": "string"
    },
    "assessment_revision": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "base": {
          "const": "supplied_record"
        },
        "hypotheses_checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hypotheses_skipped": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "external_sources_fetched": {
          "const": false
        },
        "coverage": {
          "enum": [
            "partial",
            "supplied_record"
          ]
        },
        "integrity_checks": {
          "type": "string"
        }
      },
      "required": [
        "base",
        "hypotheses_checked",
        "hypotheses_skipped",
        "external_sources_fetched",
        "coverage",
        "integrity_checks"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/attention"
      }
    }
  },
  "required": [
    "schema_version",
    "assessment_profile",
    "attention_policy",
    "record_revision",
    "assessment_revision",
    "scope"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kpopper recorded assessment v1",
  "$defs": {
    "side": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "recorded"
            },
            "value": {}
          },
          "required": [
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "missing"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "current": {
          "$ref": "#/$defs/side"
        },
        "at_review": {
          "$ref": "#/$defs/side"
        },
        "comparison": {
          "enum": [
            "same",
            "changed",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_changed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "historical_calculation": {
          "type": "object",
          "properties": {
            "value": {},
            "rule": {}
          },
          "required": [
            "value",
            "rule"
          ],
          "additionalProperties": false
        },
        "historical_formula_only": {
          "type": "boolean"
        }
      },
      "required": [
        "current",
        "at_review",
        "comparison",
        "reasons",
        "rule_changed"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "comparison": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "basis": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "assessed",
            "error",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": [
        "status",
        "dependencies"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "error"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "falsifier": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "holds",
            "does_not_hold",
            "not_declared",
            "not_applicable",
            "unknown",
            "error"
          ]
        },
        "expression": {},
        "reads": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "expression",
        "reads"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "error"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "holds",
                  "does_not_hold"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reads": {
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "contention": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "detected",
            "none_detected",
            "unassessed"
          ]
        },
        "method": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hypothesis": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "hypothesis",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "witnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hypothesis": {
                "type": "string"
              },
              "claim": {}
            },
            "required": [
              "hypothesis",
              "claim"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "alternatives",
        "witnesses"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unassessed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "detected"
              }
            }
          },
          "then": {
            "properties": {
              "witnesses": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "integrity": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "assessed",
            "unassessed",
            "error"
          ]
        },
        "reason": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "required": [
        "status",
        "checks",
        "issues"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "error",
                  "unassessed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "falsifier": {
          "$ref": "#/$defs/falsifier"
        },
        "contention": {
          "$ref": "#/$defs/contention"
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        }
      },
      "required": [
        "basis",
        "falsifier",
        "contention",
        "integrity"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "body": {},
        "state": {
          "$ref": "#/$defs/state"
        },
        "attention": {
          "$ref": "#/$defs/attention"
        }
      },
      "required": [
        "body",
        "state",
        "attention"
      ],
      "additionalProperties": false
    },
    "attention": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "review",
              "repair_record",
              "resolve_gap",
              "inspect_alternatives"
            ]
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/issue"
            }
          }
        },
        "required": [
          "action",
          "reasons"
        ],
        "additionalProperties": false
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "nodes"
      ],
      "not": {
        "required": [
          "attention"
        ]
      }
    },
    {
      "required": [
        "attention"
      ],
      "not": {
        "required": [
          "nodes"
        ]
      }
    }
  ]
}
