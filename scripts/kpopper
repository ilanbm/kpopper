#!/usr/bin/env python3
"""The dispatcher as a plain executable, for a checkout that was never installed.

`scripts/kpopper check` and an installed `kpopper check` run the same code: cli.py,
sitting next to the reader and the renderer it drives.
"""
import pathlib, sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from cli import main

main()
