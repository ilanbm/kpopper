{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/scripts/session_open.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/scripts/ingestion_hook.sh\" claude start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/scripts/session_gate.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/scripts/ingestion_hook.sh\" claude wait",
            "asyncRewake": true,
            "timeout": 130
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/scripts/followups_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/scripts/ingestion_hook.sh\" claude wait",
            "asyncRewake": true,
            "timeout": 130
          }
        ]
      }
    ]
  }
}
