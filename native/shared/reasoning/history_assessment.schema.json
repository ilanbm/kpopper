{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {"const": 3},
    "assessment_profile": {"const": "core/v1"},
    "attention_policy": {
      "enum": ["focused-review/v1", "falsifiers-only/v1"]
    },
    "snapshot_id": {"$ref": "#/$defs/digest"},
    "as_of": {"type": ["string", "null"]},
    "assessment_selection": {"$ref": "#/$defs/ids"},
    "history_selection": {"$ref": "#/$defs/ids"},
    "display_selection": {"$ref": "#/$defs/ids"},
    "operational_limits": {"$ref": "#/$defs/operational_limits"},
    "scope": {
      "type": "object",
      "properties": {
        "context": {"type": "object"},
        "hypotheses": {"type": "object"},
        "external_sources_fetched": {"const": false},
        "evidence": {"type": "string"}
      },
      "required": ["context", "hypotheses", "external_sources_fetched", "evidence"],
      "additionalProperties": false
    },
    "history": {"$ref": "#/$defs/history_summary"},
    "base_assessment_revision": {"$ref": "#/$defs/digest"},
    "nodes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/node"}
    },
    "history_subjects": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/history_subject"}
    },
    "findings_revision": {"$ref": "#/$defs/digest"},
    "envelope_revision": {"$ref": "#/$defs/digest"}
  },
  "required": [
    "schema_version", "assessment_profile", "attention_policy", "snapshot_id", "as_of",
    "assessment_selection", "history_selection", "display_selection", "operational_limits",
    "scope", "history", "base_assessment_revision", "nodes", "history_subjects",
    "findings_revision", "envelope_revision"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "history": {
            "properties": {"authority_status": {"const": "not_active"}},
            "required": ["authority_status"]
          }
        }
      },
      "then": {
        "properties": {
          "history_subjects": {"maxProperties": 0},
          "nodes": {
            "additionalProperties": {
              "properties": {
                "acceptance": {
                  "properties": {"status": {"const": "not_applicable"}}
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "nodes": {
            "additionalProperties": {
              "properties": {
                "acceptance": {
                  "properties": {"status": {"$ref": "#/$defs/acceptance"}}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "acceptance": {
      "enum": [
        "accepted", "proposed", "contested", "refuted", "corrected",
        "retired", "unreviewed", "unavailable"
      ]
    },
    "operational_limits": {
      "type": "object",
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "batch_requests": {"type": "integer", "minimum": 1, "maximum": 1000},
        "input_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864}
      },
      "required": ["timeout_seconds", "batch_requests", "input_bytes", "output_bytes"],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "code": {"type": "string"},
        "subject": {"type": "string"},
        "object_id": {"type": "string"},
        "detail": {"type": "string"}
      },
      "required": ["code", "subject", "object_id", "detail"],
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "included": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "findings": {"type": "array", "items": {"type": "object"}}
      },
      "required": ["included", "complete", "findings"],
      "additionalProperties": false
    },
    "pin_evidence": {
      "type": "object",
      "properties": {
        "status": {"enum": ["recorded", "unavailable"]},
        "evidence_kind": {"const": "version_pin"},
        "subject": {"type": ["string", "null"]},
        "version": {"type": "string"},
        "body": {},
        "profile": {"type": ["string", "null"]},
        "value_status": {"enum": ["recorded", "unavailable"]},
        "value": {},
        "basis_status": {"enum": ["recorded", "not_recorded", "unavailable"]},
        "basis": {},
        "findings": {"type": "array", "items": {"type": "object"}}
      },
      "required": [
        "status", "evidence_kind", "subject", "version", "body", "profile",
        "value_status", "value", "basis_status", "basis", "findings"
      ],
      "additionalProperties": false
    },
    "reservation": {
      "type": "object",
      "properties": {
        "code": {"type": "string"},
        "state": {
          "enum": [
            "accepted", "proposed", "contested", "refuted", "corrected",
            "retired", "unreviewed", "unavailable", "moved", "fired", "unknown"
          ]
        },
        "subject": {"type": "string"},
        "version": {"type": "string"},
        "path": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["code", "state", "subject", "version", "path"],
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "properties": {
        "reducer": {"const": "necessary-support/v1"},
        "status": {"enum": ["clear", "reserved"]},
        "visited": {"$ref": "#/$defs/ids"},
        "visited_count": {"type": "integer", "minimum": 0},
        "reservations": {"type": "array", "items": {"$ref": "#/$defs/reservation"}}
      },
      "required": ["reducer", "status", "visited", "visited_count", "reservations"],
      "additionalProperties": false
    },
    "assurance": {
      "type": "object",
      "properties": {
        "actual": {
          "type": "object",
          "properties": {
            "node": {"type": ["object", "null"]},
            "falsifier": {"type": ["object", "null"]},
            "dependencies": {
              "type": "object",
              "additionalProperties": {"type": ["object", "null"]}
            }
          },
          "required": ["node", "falsifier", "dependencies"],
          "additionalProperties": false
        },
        "recorded_evidence_kinds": {
          "type": "array",
          "items": {"enum": ["version_pin", "review_pin"]},
          "uniqueItems": true
        }
      },
      "required": ["actual", "recorded_evidence_kinds"],
      "additionalProperties": false
    },
    "node_acceptance": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "accepted", "proposed", "contested", "refuted", "corrected", "retired",
            "unreviewed", "unavailable", "not_applicable"
          ]
        },
        "head_ids": {"$ref": "#/$defs/ids"},
        "open_act_ids": {"$ref": "#/$defs/ids"}
      },
      "required": ["status", "head_ids", "open_act_ids"],
      "additionalProperties": false
    },
    "node_history": {
      "type": "object",
      "properties": {
        "subject_id": {"type": ["string", "null"]},
        "current_head_witnesses": {
          "type": "array", "items": {"$ref": "#/$defs/pin_evidence"}
        },
        "proposals": {"$ref": "#/$defs/ids"},
        "reviews": {"type": "array", "items": {"type": "object"}},
        "disposition_marks": {
          "type": "object",
          "additionalProperties": {
            "enum": ["corrected", "refuted", "retired", "replaced", "superseded"]
          }
        },
        "contested_claims": {"$ref": "#/$defs/ids"},
        "implied_reservations": {"type": "array", "items": {"type": "object"}},
        "recorded_support": {
          "type": "object", "additionalProperties": {"$ref": "#/$defs/pin_evidence"}
        },
        "pin_review_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "review_id": {"type": "string"},
              "of": {"type": "string"},
              "read": {
                "type": "object", "additionalProperties": {"$ref": "#/$defs/pin_evidence"}
              }
            },
            "required": ["review_id", "of", "read"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "subject_id", "current_head_witnesses", "proposals", "reviews", "disposition_marks",
        "contested_claims", "implied_reservations", "recorded_support", "pin_review_evidence"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "body": {},
        "fields": {"type": "object"},
        "state": {"type": "object"},
        "attention": {"type": "array"},
        "computation": {"type": ["object", "null"]},
        "acceptance": {"$ref": "#/$defs/node_acceptance"},
        "history": {"$ref": "#/$defs/node_history"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "assurance": {"$ref": "#/$defs/assurance"},
        "support": {"$ref": "#/$defs/support"},
        "temporal": {"$ref": "#/$defs/temporal"}
      },
      "required": [
        "body", "fields", "state", "attention", "computation", "acceptance",
        "history", "coverage", "assurance", "support"
      ],
      "additionalProperties": false
    },
    "history_subject": {
      "type": "object",
      "properties": {
        "acceptance": {"$ref": "#/$defs/acceptance"},
        "head_ids": {"$ref": "#/$defs/ids"},
        "open_act_ids": {"$ref": "#/$defs/ids"},
        "head_witnesses": {"type": "array", "items": {"$ref": "#/$defs/pin_evidence"}},
        "proposals": {"$ref": "#/$defs/ids"},
        "reviews": {"type": "array", "items": {"type": "object"}},
        "disposition_marks": {
          "type": "object",
          "additionalProperties": {
            "enum": ["corrected", "refuted", "retired", "replaced", "superseded"]
          }
        },
        "contested_claims": {"$ref": "#/$defs/ids"},
        "implied_reservations": {"type": "array", "items": {"type": "object"}},
        "recorded_support": {
          "type": "object", "additionalProperties": {"$ref": "#/$defs/pin_evidence"}
        },
        "pin_review_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "review_id": {"type": "string"},
              "of": {"type": "string"},
              "read": {
                "type": "object", "additionalProperties": {"$ref": "#/$defs/pin_evidence"}
              }
            },
            "required": ["review_id", "of", "read"],
            "additionalProperties": false
          }
        },
        "coverage": {"$ref": "#/$defs/coverage"},
        "support": {"$ref": "#/$defs/support"},
        "source_state": {"enum": ["committed", "prepared_candidate"]},
        "temporal": {"$ref": "#/$defs/temporal"}
      },
      "required": [
        "acceptance", "head_ids", "open_act_ids", "head_witnesses", "proposals",
        "reviews", "disposition_marks", "contested_claims", "implied_reservations",
        "recorded_support", "pin_review_evidence", "coverage", "support"
      ],
      "additionalProperties": false
    },
    "history_summary": {
      "oneOf": [
        {
          "type": "object",
          "properties": {"authority_status": {"const": "not_active"}},
          "required": ["authority_status"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "authority_status": {"const": "active"},
            "review_profile": {"const": "lineage-review/v1"},
            "projection_version": {"const": 1},
            "authority": {
              "type": "object",
              "properties": {
                "record_id": {"type": "string"},
                "generation": {"type": "integer", "minimum": 0},
                "identity": {"$ref": "#/$defs/digest"}
              },
              "required": ["record_id", "generation", "identity"],
              "additionalProperties": false
            },
            "committed_set_digest": {"$ref": "#/$defs/digest"},
            "closure_digest": {"$ref": "#/$defs/digest"},
            "coverage": {
              "type": "object",
              "properties": {
                "scope": {"enum": ["all", "selected"]},
                "subjects": {"$ref": "#/$defs/ids"},
                "complete": {"type": "boolean"}
              },
              "required": ["scope", "subjects", "complete"],
              "additionalProperties": false
            },
            "identity_schemes": {"$ref": "#/$defs/ids"},
            "capabilities": {
              "type": "array",
              "items": {"const": "temporal-applicability/v1"},
              "uniqueItems": true
            },
            "integrity": {
              "type": "object",
              "properties": {
                "complete": {"type": "boolean"},
                "findings": {"type": "array", "items": {"type": "object"}}
              },
              "required": ["complete", "findings"],
              "additionalProperties": false
            }
          },
          "required": [
            "authority_status", "projection_version", "authority", "committed_set_digest",
            "closure_digest", "coverage", "identity_schemes", "integrity"
          ],
          "additionalProperties": false
        }
      ]
    },
    "temporal": {
      "type": "object",
      "properties": {
        "version": {"const": 1},
        "applicability": {"enum": ["current", "anchored", "general"]},
        "status": {"enum": ["clear", "recovered", "counterexample", "unknown"]},
        "current_falsifier": {"type": "string"},
        "complete": {"type": "boolean"},
        "counterexample_claim_ids": {"$ref": "#/$defs/ids"},
        "episodes": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "evidence_version": {"const": 1},
              "operation": {"type": "string"},
              "phase": {"enum": ["before", "after"]},
              "subject": {"type": "string"},
              "claim_id": {"type": "string"},
              "evidence_kind": {
                "enum": ["recorded_receipt", "reconstructed_committed_world"]
              },
              "applicability": {"enum": ["current", "anchored", "general"]},
              "predicate_digest": {"$ref": "#/$defs/digest"},
              "anchors": {
                "type": "object",
                "properties": {"on": {}, "at": {}, "applies": {}},
                "required": ["on", "at", "applies"],
                "additionalProperties": false
              },
              "snapshot_id": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "as_of": {"type": ["string", "null"]},
              "verification": {"enum": ["verified", "unknown"]},
              "outcome": {"enum": ["counterexample", "not_counterexample", "unknown"]},
              "finding": {"type": ["string", "null"]},
              "result": {"type": ["object", "null"]}
            },
            "required": [
              "evidence_version", "operation", "phase", "subject", "claim_id", "evidence_kind",
              "applicability", "predicate_digest", "anchors", "snapshot_id", "as_of",
              "verification", "outcome", "finding", "result"
            ],
            "additionalProperties": false
          }
        },
        "findings": {"type": "array", "items": {"type": "object"}}
      },
      "required": [
        "version", "applicability", "status", "current_falsifier", "complete",
        "counterexample_claim_ids", "episodes", "findings"
      ],
      "additionalProperties": false
    }
  }
}
