{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "assessment_profile": {
      "const": "core/v1"
    },
    "attention_policy": {
      "enum": [
        "focused-review/v1",
        "falsifiers-only/v1"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "context": {
          "type": "object"
        },
        "hypotheses": {
          "type": "object"
        },
        "external_sources_fetched": {
          "const": false
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "context",
        "hypotheses",
        "external_sources_fetched",
        "evidence"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessment_revision": {
      "type": "string"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "body": {},
          "fields": {
            "type": "object",
            "properties": {
              "deps": {
                "type": "string"
              },
              "snapshot": {
                "type": "string"
              },
              "predicate": {
                "type": "string"
              }
            },
            "required": [
              "deps",
              "snapshot",
              "predicate"
            ],
            "additionalProperties": false
          },
          "state": {
            "type": "object",
            "properties": {
              "basis": {
                "type": "object",
                "required": [
                  "status",
                  "dependencies"
                ]
              },
              "falsifier": {
                "type": "object",
                "required": [
                  "status",
                  "expression",
                  "reads"
                ]
              },
              "contention": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "detected",
                      "none_detected"
                    ]
                  },
                  "witnesses": {
                    "type": "array"
                  },
                  "alternatives": {
                    "type": "array"
                  }
                },
                "required": [
                  "status",
                  "witnesses",
                  "alternatives"
                ],
                "additionalProperties": false
              },
              "integrity": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "assessed"
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "issues": {
                    "type": "array"
                  }
                },
                "required": [
                  "status",
                  "checks",
                  "issues"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "basis",
              "falsifier",
              "contention",
              "integrity"
            ],
            "additionalProperties": false
          },
          "attention": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "related_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "code",
                      "related_ids"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "action",
                "reasons"
              ],
              "additionalProperties": false
            }
          },
          "computation": {
            "oneOf": [
              {
                "$ref": "#/$defs/result"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "body",
          "fields",
          "state",
          "attention",
          "computation"
        ],
        "additionalProperties": false
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "related_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "code",
                  "related_ids"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "action",
            "reasons"
          ],
          "additionalProperties": false
        }
      }
    },
    "operational_limits": {
      "$ref": "#/$defs/operational_limits"
    }
  },
  "required": [
    "schema_version",
    "assessment_profile",
    "attention_policy",
    "snapshot_id",
    "as_of",
    "scope",
    "selection",
    "assessment_revision",
    "operational_limits"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "nodes"
      ],
      "not": {
        "required": [
          "attention"
        ]
      }
    },
    {
      "required": [
        "attention"
      ],
      "not": {
        "required": [
          "nodes"
        ]
      }
    }
  ],
  "$defs": {
    "node_witness": {
      "type": "object",
      "properties": {
        "kind": { "const": "node" },
        "id": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["kind", "id", "fingerprint"],
      "additionalProperties": false
    },
    "scope_witness": {
      "type": "object",
      "properties": {
        "kind": { "const": "scope" },
        "scope_id": { "type": "string", "minLength": 1 },
        "definition_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "membership_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "projected_inputs_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["kind", "scope_id", "definition_digest", "membership_digest",
                   "projected_inputs_digest"],
      "additionalProperties": false
    },
    "witness": {
      "oneOf": [
        { "$ref": "#/$defs/node_witness" },
        { "$ref": "#/$defs/scope_witness" }
      ]
    },
    "diagnostic_location": {
      "type": "object",
      "properties": {
        "candidate": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["where", "value", "preflight", "aggregate"] }
      },
      "required": ["candidate", "column", "phase"],
      "additionalProperties": false
    },
    "diagnostic_v1": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "related_ids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["code", "related_ids"],
      "additionalProperties": false
    },
    "diagnostic_v2": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "related_ids": { "type": "array", "items": { "type": "string" } },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/diagnostic_location" } }
      },
      "required": ["code", "related_ids", "locations"],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "number"
            },
            "numerator": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "required": [
            "type",
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "null"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "record"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        }
      ]
    },
    "query_basis": {
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "recipe": { "const": "query-inputs/v1" },
        "profile": { "const": "core/v1" },
        "modules": { "type": "array", "items": { "type": "string" } },
        "as_of": { "type": ["string", "null"] },
        "operation": { "type": "object" },
        "scope": { "type": "object" },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/witness" } },
        "resources": { "type": "object" },
        "preflight_cost": {
          "type": "object",
          "properties": {
            "candidates": { "type": "integer", "minimum": 0 },
            "field_reads": { "type": "integer", "minimum": 0 },
            "preflight_steps": { "type": "integer", "minimum": 0 },
            "step_upper_bound": { "type": "integer", "minimum": 0 }
          },
          "required": ["candidates", "field_reads", "preflight_steps", "step_upper_bound"],
          "additionalProperties": false
        },
        "query_counts": {
          "type": "object",
          "properties": {
            "input_count": { "type": "integer", "minimum": 0 },
            "definite_match_count": { "type": "integer", "minimum": 0 },
            "unknown_membership_count": { "type": "integer", "minimum": 0 },
            "unknown_value_count": { "type": "integer", "minimum": 0 },
            "error_count": { "type": "integer", "minimum": 0 }
          },
          "required": ["input_count", "definite_match_count", "unknown_membership_count",
                       "unknown_value_count", "error_count"],
          "additionalProperties": false
        },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["version", "recipe", "profile", "modules", "as_of", "operation", "scope",
                   "dependencies", "resources", "preflight_cost", "query_counts", "digest"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [1, 2]
        },
        "profile": {
          "const": "core/v1"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshot_id": {
          "type": "string"
        },
        "computation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation": {
          "type": [
            "object",
            "null"
          ]
        },
        "resource_profile": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "version": {
                  "const": "resources/v2"
                },
                "steps": {
                  "type": "integer",
                  "minimum": 0
                },
                "depth": {
                  "type": "integer",
                  "minimum": 0
                },
                "digits": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "version",
                "steps",
                "depth",
                "digits"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "version": {
                  "const": "resources/v3"
                },
                "steps": {
                  "type": "integer",
                  "minimum": 0
                },
                "depth": {
                  "type": "integer",
                  "minimum": 0
                },
                "digits": {
                  "type": "integer",
                  "minimum": 0
                },
                "value_nodes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "value_depth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 128
                },
                "value_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16777216
                }
              },
              "required": [
                "version",
                "steps",
                "depth",
                "digits",
                "value_nodes",
                "value_depth",
                "value_bytes"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "version": { "const": "resources/v4" },
                "steps": { "type": "integer", "minimum": 0 },
                "depth": { "type": "integer", "minimum": 0 },
                "digits": { "type": "integer", "minimum": 0 },
                "value_nodes": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "value_depth": { "type": "integer", "minimum": 1, "maximum": 128 },
                "value_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
                "candidates": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "field_reads": { "type": "integer", "minimum": 1, "maximum": 100000 }
              },
              "required": ["version", "steps", "depth", "digits", "value_nodes",
                           "value_depth", "value_bytes", "candidates", "field_reads"],
              "additionalProperties": false
            }
          ]
        },
        "status": {
          "enum": [
            "ok",
            "unknown",
            "error",
            "limit",
            "unsupported_capability",
            "operational_error"
          ]
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/diagnostic_v1" },
              { "$ref": "#/$defs/diagnostic_v2" }
            ]
          }
        },
        "executed_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          }
        },
        "potential_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          }
        },
        "potential_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "basis": {
          "type": [
            "object",
            "null"
          ]
        },
        "query_counts": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "input_count": { "type": "integer", "minimum": 0 },
                "definite_match_count": { "type": "integer", "minimum": 0 },
                "unknown_membership_count": { "type": "integer", "minimum": 0 },
                "unknown_value_count": { "type": "integer", "minimum": 0 },
                "error_count": { "type": "integer", "minimum": 0 }
              },
              "required": ["input_count", "definite_match_count", "unknown_membership_count",
                           "unknown_value_count", "error_count"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "assurance": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "computed"
            },
            "formal_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "implementation": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "formal_scope"
          ],
          "additionalProperties": false
        },
        "cost": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "steps": { "type": "integer", "minimum": 0 },
                "node_evaluations": { "type": "object", "additionalProperties": {
                  "type": "integer", "minimum": 0 } },
                "preflight_steps": { "type": "integer", "minimum": 0 }
              },
              "required": ["steps", "node_evaluations", "preflight_steps"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "steps": { "type": "integer", "minimum": 0 },
                "node_evaluations": { "type": "object", "additionalProperties": {
                  "type": "integer", "minimum": 0 } },
                "preflight_steps": { "type": "integer", "minimum": 0 },
                "candidates": { "type": "integer", "minimum": 0 },
                "field_reads": { "type": "integer", "minimum": 0 },
                "evaluated_field_reads": { "type": "integer", "minimum": 0 }
              },
              "required": ["steps", "node_evaluations", "preflight_steps", "candidates",
                           "field_reads", "evaluated_field_reads"],
              "additionalProperties": false
            }
          ]
        },
        "interpretation": {
          "type": "object",
          "properties": {
            "declared_profile": {
              "type": "string"
            },
            "explicit_override": {
              "const": "core/v1"
            }
          },
          "required": [
            "declared_profile",
            "explicit_override"
          ],
          "additionalProperties": false
        },
        "operational_limits": {
          "$ref": "#/$defs/operational_limits"
        }
      },
      "required": [
        "schema_version",
        "profile",
        "modules",
        "snapshot_id",
        "computation_id",
        "implementation",
        "resource_profile",
        "status",
        "value",
        "diagnostics",
        "executed_reads",
        "potential_dependencies",
        "potential_ids",
        "basis",
        "assurance",
        "cost",
        "operational_limits"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "schema_version": { "const": 1 } } },
          "then": {
            "not": { "required": ["query_counts"] },
            "properties": {
              "diagnostics": { "items": { "$ref": "#/$defs/diagnostic_v1" } },
              "resource_profile": { "properties": { "version": {
                "enum": ["resources/v2", "resources/v3"] } } },
              "cost": {
                "type": "object",
                "required": ["steps", "node_evaluations", "preflight_steps"],
                "not": { "anyOf": [
                  { "required": ["candidates"] }, { "required": ["field_reads"] },
                  { "required": ["evaluated_field_reads"] }
                ] }
              }
            }
          },
          "else": {
            "required": ["query_counts"],
            "properties": {
              "diagnostics": { "items": { "$ref": "#/$defs/diagnostic_v2" } },
              "resource_profile": { "properties": { "version": { "const": "resources/v4" } } },
              "cost": { "required": ["candidates", "field_reads", "evaluated_field_reads"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": { "const": 2 },
              "status": { "const": "ok" }
            },
            "required": ["schema_version", "status"]
          },
          "then": {
            "properties": {
              "query_counts": { "type": "object" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": { "const": 2 },
              "query_counts": { "type": "object" }
            },
            "required": ["schema_version", "query_counts"]
          },
          "then": {
            "properties": {
              "basis": { "$ref": "#/$defs/query_basis" },
              "computation_id": { "type": "string" }
            }
          },
          "else": {
            "if": {
              "properties": { "schema_version": { "const": 2 } },
              "required": ["schema_version"]
            },
            "then": {
              "properties": {
                "basis": { "type": "null" },
                "computation_id": { "type": "null" }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "operational_limits": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "batch_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      },
      "required": [
        "timeout_seconds",
        "batch_requests",
        "input_bytes",
        "output_bytes"
      ],
      "additionalProperties": false
    }
  }
}
