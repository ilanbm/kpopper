{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kpopper:selected-view-delta:v1",
  "title": "Same-revision selected canonical view delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "scope", "project_sha256", "base_sha256", "target_sha256", "base_evidence_sha256", "target_evidence_sha256", "evidence_additions", "metadata", "focus"],
  "properties": {
    "schema": {"const": "kpopper.selected-view-delta/v1"},
    "revision": {"type": "string"},
    "scope": {"type": "string"},
    "project_sha256": {"$ref": "#/$defs/sha256"},
    "base_sha256": {"$ref": "#/$defs/sha256"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "base_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "target_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_additions": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["set", "unset"],
      "properties": {
        "set": {
          "type": "object",
          "propertyNames": {"not": {"const": "nodes"}},
          "properties": {
            "dictionary": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["slot", "identity"],
                "properties": {
                  "slot": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"enum": ["n", "g", "f", "m", "x"]}, {"type": "integer", "minimum": 0}]},
                  "identity": {"$ref": "#/$defs/identity"}
                }
              }
            },
            "groups": {"type": "array", "items": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"$ref": "#/$defs/groupIdentity"}, {"type": "integer", "minimum": 0}, {}, {}]}},
            "links": {"type": "array", "items": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{"$ref": "#/$defs/identity"}, {}, {"$ref": "#/$defs/identity"}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}]}},
            "expanded_edges": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "array", "items": {"type": "object"}}]}},
            "navigation_facets": {
              "type": "object", "required": ["groups", "nodes"],
              "properties": {
                "groups": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/groupIdentity"}, {"type": "integer", "minimum": 0}]}},
                "nodes": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/nodeIdentity"}, {"type": "array", "items": {"$ref": "#/$defs/groupIdentity"}}]}}
              }
            }
          }
        },
        "unset": {"$ref": "#/$defs/strings"}
      }
    },
    "focus": {
      "type": "object", "additionalProperties": false, "required": ["upsert", "fold", "order"],
      "properties": {
        "upsert": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["source_id", "body_sha256", "attributes"],
            "properties": {"source_id": {"type": "string"}, "body_sha256": {"$ref": "#/$defs/sha256"}, "attributes": {"type": "object"}}
          }
        },
        "fold": {"$ref": "#/$defs/strings"},
        "order": {"$ref": "#/$defs/strings"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "nodeIdentity": {"type": "object", "required": ["kind", "original"], "properties": {"kind": {"const": "node"}, "original": {"type": "string"}}},
    "groupIdentity": {"type": "object", "required": ["kind", "original"], "properties": {"kind": {"const": "group"}, "original": {"type": "string"}}},
    "identity": {"oneOf": [
      {"$ref": "#/$defs/nodeIdentity"}, {"$ref": "#/$defs/groupIdentity"},
      {"type": "object", "required": ["kind", "original_present", "original"], "properties": {"kind": {"const": "external"}, "original_present": {"type": "boolean"}, "original": {}}}
    ]},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "body_sha256", "body"],
      "properties": {"source_id": {"type": "string"}, "body_sha256": {"$ref": "#/$defs/sha256"}, "body": {"$ref": "#/$defs/typedValue"}}
    },
    "typedValue": {"oneOf": [
      {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"const": "null"}]},
      {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "bool"}, {"type": "boolean"}]},
      {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"enum": ["text", "date", "datetime", "float"]}, {"type": "string"}]},
      {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "int"}, {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"}]},
      {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "list"}, {"type": "array", "items": {"$ref": "#/$defs/typedValue"}}]},
      {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "map"}, {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "string"}, {"$ref": "#/$defs/typedValue"}]}}]}
    ]}
  }
}
